# URL base de la API (incluye el prefijo /api). Si cambias el puerto de la API, cámbialo aquí también.
# Cópialo a .env.local. Si el origen de la web cambia, ajusta FRONTEND_URL en apps/api/.env.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Opcional, solo servidor: URL de la API para los Server Components (p. ej. una red interna).
# Si no existe se usa API_PROXY_DESTINO y, sin él, NEXT_PUBLIC_API_URL.
# API_URL=http://localhost:3001/api

# Opcional, solo para la demo con web y API en dominios distintos (docs/despliegue-demo.md): la web
# reenvía /api a este destino (URL HTTP(S) absoluta, con /api). Exige NEXT_PUBLIC_API_URL=/api y
# se fija al compilar: si cambia, hay que recompilar.
# API_PROXY_DESTINO=https://tu-api.up.railway.app/api

# Opcional: origen público de la web (base de las URLs absolutas de Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
