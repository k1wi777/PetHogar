# URL base de la API (incluye el prefijo /api). Si cambias el puerto de la API, cámbialo aquí también.
# Cópialo a .env.local. Si el origen de la web cambia, ajusta FRONTEND_URL en apps/api/.env.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Opcional, solo servidor: URL de la API para los Server Components (p. ej. una red interna).
# Si no existe se usa NEXT_PUBLIC_API_URL.
# API_URL=http://localhost:3001/api

# Opcional: origen público de la web (base de las URLs absolutas de Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
