PORT=3001

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=pethogar
DATABASE_PASSWORD=pethogar
DATABASE_NAME=pethogar

JWT_ACCESS_SECRET=dev-access-secret-cambiar-en-produccion
JWT_REFRESH_SECRET=dev-refresh-secret-cambiar-en-produccion

SMTP_HOST=localhost
# Debe coincidir con MAILPIT_SMTP_PORT del .env de la raíz si se cambió.
SMTP_PORT=1025
SMTP_FROM="PetHogar <no-reply@pethogar.local>"
# Opcionales: Mailpit no usa autenticación. SMTP_SECURE=true para TLS directo (puerto 465).
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

UPLOADS_DIR=./uploads
# Opcional: base de las URLs de archivos públicos (por defecto http://localhost:PORT).
API_PUBLIC_URL=http://localhost:3001
# Endpoints temporales de prueba (/api/pruebas/*). Con false o sin definir responden 404.
HABILITAR_ENDPOINTS_PRUEBA=true
FRONTEND_URL=http://localhost:3000

# Seed (pnpm --filter api seed). Valores de desarrollo: cambiar. No se exigen para arrancar la API.
SEED_ADMIN_EMAIL=admin@pethogar.local
SEED_ADMIN_PASSWORD=cambiar-esta-clave-admin
SEED_ADMIN_TELEFONO=3000000000
# Solo con --demo (pnpm --filter api seed:demo)
SEED_DEMO_PASSWORD=cambiar-clave-demo
