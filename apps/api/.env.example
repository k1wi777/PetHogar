PORT=3001

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=pethogar
DATABASE_PASSWORD=pethogar
DATABASE_NAME=pethogar

# Secretos: mínimo 32 caracteres, distintos entre sí. Con NODE_ENV=production la API no arranca
# si conservan el valor de ejemplo (genera uno con: openssl rand -base64 48).
JWT_ACCESS_SECRET=dev-access-secret-cambiar-en-produccion
JWT_REFRESH_SECRET=dev-refresh-secret-cambiar-en-produccion

# Autenticación (todas opcionales; se muestran los valores por defecto).
NODE_ENV=development
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_DAYS=7
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15
VERIFICACION_EXPIRA_HORAS=24
# Recuperación de contraseña: vigencia (minutos) del código de 6 dígitos y fallos permitidos por código.
RESET_CODE_EXPIRA_MIN=15
RESET_CODE_MAX_INTENTOS=5
# Tareas programadas de seguimientos (todas opcionales; valores por defecto). Las expresiones cron
# son de 5 campos y se evalúan en la hora de America/Bogota. Con CRON_HABILITADO=false no se
# programa ningún temporizador.
SEGUIMIENTOS_CRON_HABILITADO=true
# Marca como vencidos los seguimientos con fecha anterior a hoy.
SEGUIMIENTOS_CRON_VENCIDOS="10 0 * * *"
# Avisa (una sola vez) de los seguimientos que vencen en los próximos días.
SEGUIMIENTOS_CRON_RECORDATORIOS="0 7 * * *"
SEGUIMIENTOS_RECORDATORIO_DIAS=3
# Detrás de un proxy inverso: número de saltos de confianza (p. ej. 1) para tomar la IP real del
# cliente en el límite de peticiones. Por defecto false (se ignora X-Forwarded-For).
# TRUST_PROXY=false
# Atributo Secure de la cookie de refresh. Sin definir: true solo con NODE_ENV=production.
# COOKIE_SECURE=false

SMTP_HOST=localhost
# Debe coincidir con MAILPIT_SMTP_PORT del .env de la raíz si se cambió.
SMTP_PORT=1025
SMTP_FROM="PetHogar <no-reply@pethogar.local>"
# Opcionales: Mailpit no usa autenticación. SMTP_SECURE=true para TLS directo (puerto 465).
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

UPLOADS_DIR=./uploads
# Opcional: base de las URLs de archivos públicos (por defecto http://localhost:PORT).
API_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Seed (pnpm --filter api seed). Valores de desarrollo: cambiar. No se exigen para arrancar la API.
SEED_ADMIN_EMAIL=admin@pethogar.local
SEED_ADMIN_PASSWORD=cambiar-esta-clave-admin
SEED_ADMIN_TELEFONO=3000000000
# Solo con --demo (pnpm --filter api seed:demo)
SEED_DEMO_PASSWORD=cambiar-clave-demo
